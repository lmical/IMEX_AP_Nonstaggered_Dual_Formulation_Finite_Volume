@article{BURMAN,
title = {Edge stabilization for {Galerkin} approximations of convection–diffusion–reaction problems},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {193},
number = {15},
pages = {1437-1453},
year = {2004},
